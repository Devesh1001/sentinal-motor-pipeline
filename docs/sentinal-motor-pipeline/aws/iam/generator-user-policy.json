{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadPipelineFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<bucket>/sentinal_motor/*"
    },
    {
      "Sid": "ListPipelineFolderOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket>",
      "Condition": { "StringLike": { "s3:prefix": ["sentinal_motor/*"] } }
    }
  ]
}
